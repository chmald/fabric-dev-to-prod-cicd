# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Editors / local state
.vscode/
.fabric_local/
tmp/

# Secrets — never commit
.env
.env.*
*.pem
*.key
secrets.json
.sp-secret.json

# Populated per-tenant IDs. Commit demo-ids.template.json only.
demo-ids.json
demo-ids.local.json
*.local.json

# Local leak-detection patterns (real customer / tenant names). See .leak-patterns.example.txt.
.leak-patterns.txt

# azd state (not used by this pattern, ignored defensively)
.azure/

# draw.io autosave / backup files
*.drawio.bkp
.$*.drawio.bkp
