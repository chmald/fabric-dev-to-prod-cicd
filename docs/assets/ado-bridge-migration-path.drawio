ht=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="660" y="200" width="270" height="110" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b style=&quot;font-size:13px&quot;&gt;3 | Values out of Git&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;variable groups + ADO environments&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=keys;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="270" height="110" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b style=&quot;font-size:13px&quot;&gt;4 | First green run&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;register YAML, push to dev&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=azure-devops;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1260" y="200" width="270" height="110" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b style=&quot;font-size:13px&quot;&gt;5 | Promote by merge&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;dev -&gt; prod, same 3 stages&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=commit;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign