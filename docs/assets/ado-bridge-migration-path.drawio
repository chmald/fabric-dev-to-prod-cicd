<mxfile host="Electron" version="26.0.0"><diagram id="ado-bridge-migration-path" name="ado-bridge-migration-path"><mxGraphModel dx="1900" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1045" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#117865;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;From 'ADO connected but unused' to a working pipeline&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Six incremental steps; each one is useful on its own, so you can stop after any step and still be better off." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="26" as="geometry"/></mxCell><mxCell id="footer" value="Fabric CI/CD with Azure DevOps  |  v2.0.0  |  Icons: Microsoft Fabric icons + Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1820" height="20" as="geometry"/></mxCell><mxCell id="g1" value="Migration path" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;spacingLeft=46;iconK