<mxfile host="Electron" version="26.0.0"><diagram id="troubleshooting-decision-tree" name="troubleshooting-decision-tree"><mxGraphModel dx="1900" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1045" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#117865;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" y="0" width="855" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Troubleshooting decision tree&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Start from the stage that failed, then the exact error string. Every leaf names the fix and the doc that owns it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1820" height="26" as="geometry"/></mxCell><mxCell id="footer" value="Fabric CI/CD with Azure DevOps  |  v2.0.0  |  Icons: Microsoft Fabric icons + Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1820" height="20" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Pipeline failed, or the workspace shows the wrong data&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.2;fontSize=13;fontFamily=Segoe UI;fontColor=#201F1E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="500" height="50" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Which stage?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontFamily=Segoe UI;fontColor=#201F1E;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="200" height="96" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" edge="1" parent="1" source="b1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Stage 1 | Validate&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;fix the item the validator names: .platform, VarLib JSON, TMDL, M params&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=code;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="400" height="90" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;Stage 2&lt;/b&gt;&lt;br/&gt;error code?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontFamily=Segoe UI;fontColor=#201F1E;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="220" height="100" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;Stage 3&lt;/b&gt;&lt;br/&gt;error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontFamily=Segoe UI;fontColor=#201F1