&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1392" y="872" width="70" height="20" as="geometry"/></mxCell><mxCell id="l31" value="" style="rounded=0;fillColor=#605E5C;strokeColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="1464" y="881" width="36" height="2" as="geometry"/></mxCell><mxCell id="x32" value="same Git content" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1508" y="872" width="194" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
