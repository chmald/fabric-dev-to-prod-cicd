=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="788" y="180" width="314" height="96" as="geometry"/></mxCell><mxCell id="t16" value="&lt;b style=&quot;font-size:13px&quot;&gt;Federated credential&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;for the ADO service connection (WIF)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=entra-workload-id;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="788" y="330" width="314" height="96" as="geometry"/></mxCell><mxCell id="t17" value="&lt;b style=&quot;font-size:13px&quot;&gt;Key Vault&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;secret-backed variable groups&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=key-vault;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="788" y="480" width="314" height="96" as="geometry"/></mxCell><mxCell id="p18" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1014" y="471" width="78" height="18" as="geometry"/></mxCell><mxCell id="g19" value="Roles + access" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF8F8;strokeColor=#117865;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#117865;font