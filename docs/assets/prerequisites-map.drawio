;" vertex="1" parent="1"><mxGeometry x="1520" y="180" width="314" height="96" as="geometry"/></mxCell><mxCell id="t26" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hosted parallel jobs&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;new orgs: request the free grant&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=azure-devops;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1520" y="330" width="314" height="96" as="geometry"/></mxCell><mxCell id="t27" value="&lt;b style=&quot;font-size:13px&quot;&gt;Local tools&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;git | Python 3.11+ | Azure CLI&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=dev-console;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1520" y="480" width="314" height="96" as="geometry"/></mxCell><mxCell id="t28" value="&lt;b style=&quot;font-size:13px&quot;&gt;draw.io desktop&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;only to re-export diagrams&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=toolbox;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1520" y="630" width="314" height="96" as="geometry"/></mxCell><mxCell id="p29" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1746" y="621" width="78" height="18" as="geometry"/></mxCell><mxCell id="b30" value="&lt;b&gt;Region.&lt;/b&gt; Fabric items live in the capacity's region. Keep Dev and Prod capacities in the same region as the data they read; the pipeline itself is region-agnostic. Check tenant-setting propagation (minutes) before the first run." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=11;fontFamily=Segoe UI;fontColor=#201F1E;align=left;verticalAlign=top;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1100" height="64" as="geometry"/></mxCell><mxCell id="b31" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1.2;fontSize=11;fontFamily=Segoe UI;fontColor=#201F1E;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="484" height="40" as="geometry"/></mxCell><mxCell id="x32" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="52" y="870" width="70" height="20" as="geometry"/></mxCell><mxCell id="p33" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124" y="871" width="78" height="18" as="geometry"/></mxCell><mxCell id="x34" value="only when the condition applies" style="text;html=1;whiteSpace=wrap;align=left;vertical