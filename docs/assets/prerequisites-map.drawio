icalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=policy;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="422" y="180" width="314" height="96" as="geometry"/></mxCell><mxCell id="t9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sync workspace items with Git&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Git integration section&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117865;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=policy;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="422" y="330" width="314" height="96" as="geometry"/></mxCell><mxCell id="t10" value="&lt;b style=&quot;font-size:13px&quot;&gt;Export items to Git in other geos&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;only if repo geo differs&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#117865;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fontSize=12;iconKey=policy;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="422" y="480" width="314" height="96" as="geometry"/></mxCell><mxCell id="p11" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="648" y="471" width="78" height="18" as="geometry"/></mxCell><mxCell id="t12" value="&lt;b style=&quot;fo